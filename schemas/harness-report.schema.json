{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techhappenseur.github.io/rocom-conformance/harness-report.schema.json",
  "title": "Rocom Conformance Harness Report",
  "description": "Machine-readable test report produced by the Rocom conformance harness. Implements eh-req-001 (JUnit XML), eh-req-002 (status vocabulary), eh-req-005 (build provenance), eh-req-023 (zero tests → NOT_RUN), eh-req-024 (success → test count).",
  "type": "object",
  "required": [
    "report_version", "timestamp", "harness_version", "test_id",
    "applies_to", "verdict", "test_count", "passed", "failed",
    "skipped", "not_run", "build_provenance", "coverage",
    "evidence", "requirements"
  ],
  "properties": {
    "report_version": {
      "type": "string",
      "description": "Schema version of this report format",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of report generation",
      "format": "date-time"
    },
    "harness_version": {
      "type": "string",
      "description": "Version of the harness that produced this report"
    },
    "test_id": {
      "type": "string",
      "description": "Unique identifier for this test run",
      "minLength": 1
    },
    "applies_to": {
      "type": "array",
      "description": "Requirement IDs this report implements (eh-req-001, eh-req-002, eh-req-005, eh-req-023, eh-req-024)",
      "items": {
        "type": "string",
        "pattern": "^eh-req-\\d{3}$"
      },
      "minItems": 1
    },
    "verdict": {
      "type": "string",
      "description": "Overall verdict. eh-req-002: PASS | FAIL | NOT_RUN | ERROR",
      "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]
    },
    "test_count": {
      "type": "integer",
      "description": "Total number of executed tests. eh-req-024: MUST be >0 for PASS/FAIL verdict.",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "not_run": {
      "type": "integer",
      "description": "Tests not executed",
      "minimum": 0
    },
    "not_run_reason": {
      "type": "string",
      "description": "eh-req-002: Reason for NOT_RUN verdict",
      "enum": [
        "missing_service",
        "missing_tool",
        "simulated",
        "no_tests_implemented",
        "preflight_failure",
        "n/a"
      ],
      "default": "n/a"
    },
    "build_provenance": {
      "type": "object",
      "description": "eh-req-005: Build provenance — toolchain, version, commit. Use {\"toolchain\": \"n/a\"} when no build exists.",
      "properties": {
        "toolchain": {
          "type": "string",
          "description": "Build toolchain identifier (e.g., 'rustc 1.97.1 stable', 'Ferrocene 24.11.0', 'n/a')"
        },
        "commit": {
          "type": "string",
          "description": "Git commit SHA of built code"
        },
        "build_artifact": {
          "type": "string",
          "description": "Path or URL to build artifact"
        },
        "build_log": {
          "type": "string",
          "description": "Path or URL to build log"
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Requirement coverage — which spec requirements were tested",
      "required": ["total_requirements", "tested_requirements", "implemented_requirements", "coverage_ratio"],
      "properties": {
        "total_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "tested_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "implemented_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_ratio": {
          "type": "string",
          "description": "Human-readable coverage string (e.g., '3/17')"
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "eh-req-001: Machine-readable evidence artifacts including JUnit XML",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["junit-xml", "log", "trace", "artifact", "preflight-report"]
          },
          "path": {
            "type": "string",
            "description": "Relative path to evidence file"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Per-requirement test results with eh-req-002 status vocabulary",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Requirement identifier (e.g., 'ID-001', 'DG-003')"
          },
          "status": {
            "type": "string",
            "description": "eh-req-002: PASS | FAIL | NOT_RUN | ERROR",
            "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]
          },
          "not_run_reason": {
            "type": "string",
            "description": "Reason if status is NOT_RUN",
            "enum": [
              "missing_service",
              "missing_tool",
              "simulated",
              "no_tests_implemented",
              "preflight_failure",
              "n/a"
            ]
          },
          "test_count": {
            "type": "integer",
            "minimum": 0
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "eh-req-023: verdict MUST be NOT_RUN if test_count is 0",
      "if": {
        "properties": { "test_count": { "const": 0 } }
      },
      "then": {
        "properties": { "verdict": { "const": "NOT_RUN" } }
      }
    },
    {
      "description": "eh-req-024: verdict MUST include test_count when PASS or FAIL",
      "if": {
        "properties": { "verdict": { "enum": ["PASS", "FAIL"] } }
      },
      "then": {
        "properties": { "test_count": { "exclusiveMinimum": 0 } }
      }
    }
  ]
}
